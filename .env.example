# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# NextAuth / Auth.js Credentials
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-key-at-least-32-chars-long

# OAuth Providers (Optional: configure if using OAuth)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Inngest Background Jobs & Cron Scheduler (decision D57)
# Local: run `npm run inngest:dev`; no keys are needed and these can stay empty.
# Production (NODE_ENV=production, or on Vercel): both keys are REQUIRED. Without them
# /api/inngest refuses to run and scheduled tasks never fire (the server log says which).
#   Signing key: https://app.inngest.com → Manage → Signing Key  (looks like signkey-prod-…)
#   Event key:   https://app.inngest.com → Manage → Event Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Only while rotating the signing key: the old key, until Inngest has switched to the new one.
INNGEST_SIGNING_KEY_FALLBACK=
# Optional: INNGEST_DEV=1 forces local mode (e.g. for `npm run build && npm start` on your
# machine); INNGEST_DEV=0 forces production checks. Never set INNGEST_DEV=1 in production.
# INNGEST_DEV=1

# OpenRouter - one key for every model. Get it at https://openrouter.ai/keys
# Model id is set in lib/ai.ts (CHAT_MODEL); browse ids at https://openrouter.ai/models
OPENROUTER_API_KEY=
# Model for every agent (an OpenRouter id). Empty = the free default in lib/ai.ts, locally only:
# production refuses an empty, malformed or free (:free) model (D59). Paid: deepseek/deepseek-chat-v3.1
OPENROUTER_MODEL=

# Email delivery for task results (optional, decision D44). Omnix emails YOU, never
# anybody else. Key: https://resend.com/api-keys — the from-domain must be verified there.
# Unset, a task that asks for email delivery lands in the in-app Inbox instead.
RESEND_API_KEY=
EMAIL_FROM="Omnix <omnix@example.com>"

# Encrypts the OAuth tokens in `connections` (decision D13).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# E2B, for each agent's own VM (decision D15, docs/06-virtual-machines.md).
# Key: https://e2b.dev/dashboard → API Keys. Unset, the run panel shows the VM as unavailable.
# Check it with: npm run verify:vm -- --live (starts one real VM for about a minute).
E2B_API_KEY=

# Slack's MCP server, for Slack tools (decision D48). The only integration that needs
# configuring: Slack has no dynamic client registration and allows only a Marketplace-
# published app or a workspace's own internal app to use MCP at all, with admin approval.
# Notion and Jira need nothing here — their servers register Omnix themselves.
# Register the callback https://<your app>/api/connections/mcp/callback on the app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
